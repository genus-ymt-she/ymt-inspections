{
  "name": "parron-inspections",
  "private": true,
  "version": "2.0.0",
  "description": "PARRON \u2013 site inspection, corrective action and MYOSH reporting app for the YMT project",
  "type": "module",
  "scripts": {
    "test": "node --test tests/unit/*.test.mjs && node tests/smoke.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:e2e": "node tests/smoke.mjs",
    "serve": "npx http-server -c-1 -p 8080 .",
    "test:workout": "node --test tests/unit/workout-logic.test.mjs && node tests/workout-e2e.mjs"
  },
  "devDependencies": {
    "playwright": "1.56.1"
  }
}
